---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import Toc from "../../components/Toc.astro";

export async function getStaticPaths() {
  // 최신순 정렬 → i-1이 더 최신(다음 글), i+1이 더 오래된(이전 글)
  const posts = (await getCollection("posts")).sort(
    (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1] ?? null, next: posts[i - 1] ?? null },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const fmt = (d?: Date) => (d ? d.toISOString().slice(0, 10).replace(/-/g, ".") : "");
const base = import.meta.env.BASE_URL;
---
<Base title={post.data.title} description={post.data.description} sidebar={false}>
  <Toc headings={headings} />
  <a class="back-link" href={base}>← Go Back</a>
  <article class="prose" data-pagefind-body>
    <div>
      {post.data.category && <span class="chip">{post.data.category}</span>}
      {post.data.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    <h1 class="title">{post.data.title}</h1>
    <div class="post-meta">{fmt(post.data.date)}</div>
    {post.data.showSummary && post.data.description && (
      <aside class="callout" data-pagefind-ignore>
        <div class="callout-label">{post.data.aiSummary ? "AI Summary" : "Summary"}</div>
        <p>{post.data.description}</p>
      </aside>
    )}
    <Content />
  </article>
  {(prev || next) && (
    <nav class="post-nav" data-pagefind-ignore>
      {prev ? (
        <a class="post-nav-item prev" href={`${base}posts/${prev.id}`}>
          <span class="post-nav-dir">← Previous</span>
          <span class="post-nav-title">{prev.data.title}</span>
        </a>
      ) : <span class="post-nav-item empty" />}
      {next ? (
        <a class="post-nav-item next" href={`${base}posts/${next.id}`}>
          <span class="post-nav-dir">Next →</span>
          <span class="post-nav-title">{next.data.title}</span>
        </a>
      ) : <span class="post-nav-item empty" />}
    </nav>
  )}
  <Comments slug={post.id} />
  <p style="margin-top:2.5rem"><a class="back-link" href={base}>← Go Back</a></p>
</Base>

<script>
  // 코드블록에 복사 버튼 주입 (View Transitions 대응: astro:page-load 마다 재실행)
  function addCopyButtons() {
    const blocks = document.querySelectorAll<HTMLPreElement>(".prose pre.astro-code");
    blocks.forEach((pre) => {
      if (pre.parentElement?.classList.contains("code-block")) return; // 이미 처리됨
      const wrap = document.createElement("div");
      wrap.className = "code-block";
      pre.replaceWith(wrap);
      wrap.appendChild(pre);

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "code-copy";
      btn.textContent = "Copy";
      btn.setAttribute("aria-label", "Copy code");
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          btn.textContent = "Copied!";
          btn.classList.add("copied");
        } catch {
          btn.textContent = "Failed";
        }
        setTimeout(() => {
          btn.textContent = "Copy";
          btn.classList.remove("copied");
        }, 1500);
      });
      wrap.appendChild(btn);
    });
  }
  document.addEventListener("astro:page-load", addCopyButtons);

  // 우측 목차 스크롤스파이: 현재 화면 상단을 지난 마지막 헤딩을 활성화.
  // window scroll 리스너는 모듈 로드 시 1회만 등록하고, DOM은 매번 라이브로 조회(View Transitions 안전).
  let tocLinks: HTMLAnchorElement[] = [];
  let tocHeads: HTMLElement[] = [];
  function refreshToc() {
    const toc = document.querySelector(".toc");
    tocLinks = toc ? Array.from(toc.querySelectorAll<HTMLAnchorElement>("a[data-toc]")) : [];
    const ids = new Set(tocLinks.map((a) => a.getAttribute("data-toc")));
    tocHeads = Array.from(
      document.querySelectorAll<HTMLElement>(".prose :is(h1, h2, h3)[id]")
    ).filter((h) => ids.has(h.id));
    updateActiveToc();
  }
  function updateActiveToc() {
    if (!tocHeads.length) return;
    let cur = tocHeads[0];
    for (const h of tocHeads) {
      if (h.getBoundingClientRect().top <= 100) cur = h; // sticky 헤더 높이만큼 오프셋
      else break;
    }
    for (const a of tocLinks) a.classList.toggle("active", a.getAttribute("data-toc") === cur.id);
  }
  window.addEventListener("scroll", updateActiveToc, { passive: true });
  document.addEventListener("astro:page-load", refreshToc);
</script>
